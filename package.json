{
  "name": "pronto-prerelease",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "tsx scripts/verify-test-db.ts && PRONTO_RUN_DB_TESTS=1 PRONTO_ENFORCE_TENANT_SQL=1 PRONTO_PREFLIGHT_IGNORE_DOTENV=1 PRONTO_SECRETS_KEY=local-test-secrets-key-with-more-than-32-characters AUTH_SECRET=local-test-auth-secret-with-more-than-32-characters APP_BASE_URL=http://127.0.0.1:3000 vitest run",
    "test:known-defects": "vitest run --config vitest.known-defects.config.ts",
    "test:db:verify": "tsx scripts/verify-test-db.ts",
    "test:db:mark": "tsx scripts/mark-test-db.ts",
    "migrate:test": "tsx scripts/verify-test-db.ts && tsx scripts/migrate.ts",
    "seed:test": "tsx scripts/verify-test-db.ts && tsx scripts/seed.ts",
    "demo:ps-cafe:setup": "tsx scripts/ps-cafe-demo.ts setup",
    "demo:ps-cafe:remove": "tsx scripts/ps-cafe-demo.ts remove",
    "demo:email:inject": "tsx scripts/demo/inject-local-email.ts",
    "demo:worker": "tsx scripts/demo/worker.ts",
    "test:local-mail": "tsx scripts/verify-test-db.ts && PRONTO_RUN_DB_TESTS=1 PRONTO_ENFORCE_TENANT_SQL=1 PRONTO_PREFLIGHT_IGNORE_DOTENV=1 PRONTO_SECRETS_KEY=local-test-secrets-key-with-more-than-32-characters AUTH_SECRET=local-test-auth-secret-with-more-than-32-characters APP_BASE_URL=http://127.0.0.1:3000 PRONTO_TEST_LOCAL_MAIL=1 PRONTO_LOCAL_EMAIL_ENABLED=1 vitest run tests/integration/local-mail-demo.test.ts",
    "chope:live-read": "tsx scripts/chope-live-read.ts",
    "meta:verify": "tsx scripts/meta-verify.ts",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/verify-test-db.ts && PRONTO_USE_MOCK_AI=1 PRONTO_LOCAL_STAFF_COMMANDS=1 PRONTO_LOCAL_STAFF_E2E=1 PRONTO_TEST_ALLOW_BUILD_IPC=0 APP_BASE_URL=http://localhost:3000 PLAYWRIGHT_BASE_URL=http://localhost:3000 NODE_OPTIONS=--import=./tests/setup/network-guard.mjs playwright test",
    "test:e2e:local-mail": "PRONTO_TEST_LOCAL_MAIL=1 PRONTO_LOCAL_EMAIL_ENABLED=1 pnpm test:e2e",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "staging:preflight": "tsx scripts/staging-preflight.ts",
    "preflight:ci": "PRONTO_PREFLIGHT_PROFILE=ci tsx scripts/staging-preflight.ts",
    "channels:encrypt-credentials": "tsx scripts/encrypt-channel-credentials.ts",
    "worker": "tsx scripts/worker.ts",
    "outbox:retry": "tsx scripts/retry-outbox.ts"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "mailparser": "^3.9.38",
    "mammoth": "^1.12.0",
    "mermaid": "^11.17.2",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "openai": "^6.38.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "playwright-core": "1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.29",
      "@xmldom/xmldom": "0.8.15",
      "brace-expansion@1.1.14": "1.1.21",
      "js-yaml": "4.3.2",
      "katex": "0.18.2",
      "source-map-js": "1.2.2",
      "undici@7.25.0": "7.29.1",
      "vite@8.0.13": "8.0.16"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687",
        "CVE-2026-97058"
      ]
    }
  }
}
