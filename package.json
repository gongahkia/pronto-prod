{
  "name": "pronto-prerelease",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "tsx scripts/verify-test-db.ts && PRONTO_RUN_DB_TESTS=1 PRONTO_ENFORCE_TENANT_SQL=1 PRONTO_PREFLIGHT_IGNORE_DOTENV=1 PRONTO_SECRETS_KEY=local-test-secrets-key-with-more-than-32-characters AUTH_SECRET=local-test-auth-secret-with-more-than-32-characters APP_BASE_URL=http://127.0.0.1:3000 vitest run",
    "test:known-defects": "vitest run --config vitest.known-defects.config.ts",
    "test:db:verify": "tsx scripts/verify-test-db.ts",
    "test:db:mark": "tsx scripts/mark-test-db.ts",
    "migrate:test": "tsx scripts/verify-test-db.ts && tsx scripts/migrate.ts",
    "seed:test": "tsx scripts/verify-test-db.ts && tsx scripts/seed.ts",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/verify-test-db.ts && PRONTO_USE_MOCK_AI=1 PRONTO_TEST_ALLOW_BUILD_IPC=0 APP_BASE_URL=http://localhost:3000 PLAYWRIGHT_BASE_URL=http://localhost:3000 NODE_OPTIONS=--import=./tests/setup/network-guard.mjs playwright test",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "staging:preflight": "tsx scripts/staging-preflight.ts",
    "preflight:ci": "PRONTO_PREFLIGHT_PROFILE=ci tsx scripts/staging-preflight.ts",
    "channels:encrypt-credentials": "tsx scripts/encrypt-channel-credentials.ts",
    "worker": "tsx scripts/worker.ts",
    "outbox:retry": "tsx scripts/retry-outbox.ts"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "next": "16.2.9",
    "openai": "^6.38.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15"
    }
  }
}
