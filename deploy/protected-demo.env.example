# Template only. Set these as server-side secrets after deployment approval.
# Never copy local fixture passwords or point test commands at this database.
NODE_ENV=production
PRONTO_DEPLOYMENT_PROFILE=protected-demo
APP_BASE_URL=https://REPLACE_WITH_APPROVED_DEMO_HOST
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_SECRET@REPLACE_HOST/pronto_demo?sslmode=verify-full
AUTH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
PRONTO_SECRETS_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
PRONTO_DEMO_DATABASE_ID=REPLACE_WITH_UUID_MATCHING_DATABASE_MARKER
PRONTO_DEMO_ALLOWED_USER_IDS=REPLACE_WITH_BOOTSTRAPPED_USER_UUIDS
PRONTO_CUSTOMER_DEMO_ENABLED=1
PRONTO_DEMO_ONLY_DELIVERY=1
PRONTO_ENFORCE_TENANT_SQL=1
PRONTO_DISABLE_TENANT_SQL_GATE=0
# Customer conversations require genuine inference; do not enable mock mode.
PRONTO_USE_MOCK_AI=0
# Current POC: only Groq is required; it uses local approved PostgreSQL text.
GROQ_API_KEY=
# Optional future Gemini configuration; unused by Groq.
GEMINI_API_KEY=
PRONTO_DEMO_REAL_AI_APPROVED=0
PRONTO_GEMINI_FREE_TIER_CONFIRMED=0
PRONTO_GROQ_FREE_TIER_CONFIRMED=0
PRONTO_CHOPE_LIVE_READS=0
CHOPE_LIVE_READ_APPROVED=0
# Web: 2 connections per instance. A separately approved worker can use 4.
PRONTO_DB_POOL_MAX=2
# Existing worker deployments omit this or use worker. Render Free uses request.
PRONTO_DEMO_PROCESSING_MODE=worker
PRONTO_WORKER_INBOUND_LIMIT=1
PRONTO_WORKER_OUTBOX_LIMIT=5
PRONTO_WORKER_OUTBOX_INTERVAL_MS=5000
# Omit PRONTO_TEST_DATABASE_URL entirely; never use the disposable-test marker.
# Optional PRONTO_DATABASE_CA contains a provider-required CA certificate.
