# PROPOSED ONLY. Not an automatic deployment file.
# Cloud acceptance and explicit deployment approval are still required.
# Never add a paid worker, Render Postgres, disk or cron to this S$0 profile.
services:
  - type: web
    name: pronto-ai-poc
    runtime: docker
    plan: free
    region: singapore
    dockerfilePath: ./deploy/render-web.Dockerfile
    dockerContext: .
    autoDeployTrigger: 'off'
    healthCheckPath: /api/health
    envVars:
      - key: NODE_ENV
        value: production
      - key: NODE_OPTIONS
        value: --max-old-space-size=256
      - key: PRONTO_DEPLOYMENT_PROFILE
        value: protected-demo
      - key: PRONTO_DB_POOL_MAX
        value: '2'
      - key: PRONTO_DEMO_PROCESSING_MODE
        value: request
      - key: PRONTO_CUSTOMER_DEMO_ENABLED
        value: '1'
      - key: PRONTO_DEMO_ONLY_DELIVERY
        value: '1'
      - key: PRONTO_ENFORCE_TENANT_SQL
        value: '1'
      - key: PRONTO_DISABLE_TENANT_SQL_GATE
        value: '0'
      - key: PRONTO_USE_MOCK_AI
        value: '0'
      - key: PRONTO_CHOPE_LIVE_READS
        value: '0'
      - key: CHOPE_LIVE_READ_APPROVED
        value: '0'
      # Confirm the existing Groq account is still on Free before supplying.
      - key: PRONTO_DEMO_REAL_AI_APPROVED
        sync: false
      - key: PRONTO_GROQ_FREE_TIER_CONFIRMED
        sync: false
      - key: GROQ_API_KEY
        sync: false
      - key: APP_BASE_URL
        sync: false
      - key: DATABASE_URL
        sync: false
      - key: AUTH_SECRET
        sync: false
      - key: PRONTO_SECRETS_KEY
        sync: false
      - key: PRONTO_DEMO_DATABASE_ID
        sync: false
      - key: PRONTO_DEMO_ALLOWED_USER_IDS
        sync: false
