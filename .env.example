DATABASE_URL=postgres://pronto:pronto@localhost:55432/pronto
AUTH_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
PRONTO_ENFORCE_TENANT_SQL=0
PRONTO_DISABLE_TENANT_SQL_GATE=0
PRONTO_LOCALE=en-SG
PRONTO_TIME_ZONE=UTC

# LLM providers. OpenAI is primary; Anthropic is optional manual fallback.
PRONTO_USE_MOCK_AI=0
PRONTO_LLM_PROVIDER=openai
PRONTO_EMBEDDING_PROVIDER=openai
PRONTO_EMBEDDING_MODEL=text-embedding-3-small
PRONTO_SECRETS_KEY=replace-with-a-long-local-secret-for-encrypted-provider-keys

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_RESPONSE_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Azure OpenAI. Use deployment names, not raw model names.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_RESPONSE_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_REASONING_EFFORT=minimal

# Optional Anthropic fallback (manual, not automatic failover).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_RESPONSE_MODEL=claude-sonnet-4-5

# Customer POC defaults to Groq + local approved text retrieval, independently of
# the ordinary provider defaults above. Only GROQ_API_KEY is required for it.
# Gemini is optional; neither provider is an automatic fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
# Only confirm after checking the account's free tier; this is not billing proof.
PRONTO_GEMINI_FREE_TIER_CONFIRMED=0
PRONTO_GROQ_FREE_TIER_CONFIRMED=0
PRONTO_DEMO_REAL_AI_APPROVED=0

# Meta WhatsApp Cloud API.
WHATSAPP_GRAPH_VERSION=v25.0
# Set appSecret, accessToken, phoneNumberId and verifyToken on each channel.

# Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=local-pronto-telegram-secret

# Meta Messenger / Instagram.
META_GRAPH_VERSION=v25.0
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
# Set pageAccessToken, appSecret, igUserId and verifyToken on each Instagram channel.

# Email channels.
POSTMARK_API_TOKEN=
POSTMARK_FROM_ADDRESS=
POSTMARK_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_WEBHOOK_SECRET=

# Optional error webhook (Slack/Discord/etc.).
PRONTO_ERROR_ALERT_WEBHOOK_URL=

# Optional local/runtime controls.
PRONTO_SKIP_LIVE_HEALTH=0
PRONTO_DISABLE_CSAT_HOOK=0
PRONTO_OUTBOX_RETRY_LIMIT=25
PRONTO_OUTBOX_STALE_SENDING_MINUTES=10
PRONTO_OUTBOX_MAX_ATTEMPTS=5
PRONTO_WORKER_OUTBOX_INTERVAL_MS=15000
PRONTO_WORKER_OUTBOX_LIMIT=25
PRONTO_WORKER_INBOUND_LIMIT=25

# Shared deadline, model-call count and total estimated prompt + output budget.
PRONTO_AGENT_TURN_TIMEOUT_MS=45000
PRONTO_AGENT_TURN_MAX_CALLS=3
PRONTO_AGENT_TURN_MAX_TOKENS=12000

# pnpm eval requires a separately configured, verified disposable pronto_test DB.
# See docs/poc/agent-engineering.md; no live provider calls are made.

# Public Chope availability (requires matching approved tenant mapping and Chromium).
# Run pnpm worker for hourly refreshes; see docs/integrations/chope-live-read.md.
PRONTO_CHOPE_LIVE_READS=0
CHOPE_LIVE_READ_APPROVED=0
PRONTO_CHOPE_LISTING_LINKS_ENABLED=1
