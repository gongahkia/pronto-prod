DATABASE_URL=postgres://pronto:pronto@localhost:55432/pronto
AUTH_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# Providers. OpenAI remains the default and is always used for embeddings in v1.
PRONTO_USE_MOCK_AI=1
PRONTO_LLM_PROVIDER=openai
PRONTO_ENABLE_PROVIDER_FAILOVER=1
PRONTO_SECRETS_KEY=replace-with-a-long-local-secret-for-encrypted-provider-keys

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_RESPONSE_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional response-generation provider for provider portability.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_RESPONSE_MODEL=claude-sonnet-4-5

# Optional free/testing provider keys. No-key providers like LLM7 and OVHcloud do not need these.
PRONTO_GROQ_API_KEY=
PRONTO_OPENROUTER_API_KEY=
PRONTO_GITHUB_MODELS_API_KEY=
PRONTO_HUGGINGFACE_API_KEY=
PRONTO_CEREBRAS_API_KEY=

# Meta WhatsApp Cloud API. Per-client channel credentials can also be stored in DB.
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=local-pronto-verify-token

# Telegram Bot API. Per-client channel credentials can also be stored in DB.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=local-pronto-telegram-secret
